{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/travel-planning/itinerary-plan.schema.json",
  "title": "Declarative itinerary assembly plan",
  "type": "object",
  "required": [
    "schema_version",
    "research_state_sha256",
    "trip",
    "workflow",
    "collections",
    "days"
  ],
  "properties": {
    "schema_version": {
      "const": "itinerary-plan/v1"
    },
    "research_state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trip": {
      "type": "object",
      "required": ["title", "date_range", "travelers", "updated_at"]
    },
    "workflow": {
      "type": "object",
      "required": ["phase", "selected_route_id"],
      "properties": {
        "phase": {
          "enum": ["confirmed_planning", "final"]
        },
        "plan_status": {
          "enum": ["candidate", "reviewed"],
          "description": "Generated plans stay candidate until the main Agent reviews planning decisions."
        },
        "selected_route_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "generator": {"const": "generate_itinerary_plan.py"},
        "mode": {"const": "candidate_plus_decisions"},
        "pending_decisions": {"type": "array", "items": {"type": "object"}}
      }
    },
    "route_proposals": {
      "type": "array",
      "items": {"type": "object"}
    },
    "collections": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/collectionBinding"}
    },
    "defaults": {
      "type": "object"
    },
    "attraction_events": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/attractionEvent"}
    },
    "meal_configs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "contract_time_window": {
            "type": "string",
            "description": "Only set when the researched meal window itself changes; day-event times control display."
          }
        }
      }
    },
    "generate_attraction_booking_tasks": {
      "type": "boolean"
    },
    "booking_tasks": {
      "type": "array",
      "items": {"type": "object"}
    },
    "restaurant_research_version": {
      "type": "integer",
      "minimum": 3
    },
    "inventory_contract_version": {
      "type": "integer",
      "minimum": 1
    },
    "planning": {
      "type": "object",
      "properties": {
        "route_continuity_version": {"type": "integer", "minimum": 1},
        "daily_routes": {
          "type": "array",
          "items": {"$ref": "#/$defs/dailyRoute"}
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "events"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "start_anchor": {"$ref": "#/$defs/routeAnchor"},
          "end_anchor": {"$ref": "#/$defs/routeAnchor"},
          "events": {
            "type": "array",
            "items": {"$ref": "#/$defs/scheduledEvent"}
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "$defs": {
    "routeAnchor": {
      "type": "object",
      "required": ["name", "coordinates"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "physical_address": {"type": "string", "minLength": 1},
        "coordinates": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?,-?[0-9]+(?:\\.[0-9]+)?$"},
        "coordinate_system": {"const": "GCJ-02"}
      }
    },
    "scheduledEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "time": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "end_time": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "type": {"enum": ["attraction", "transport", "meal", "lodging", "rest", "note"]},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "details": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tips": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"not": {"required": ["description"]}},
        {
          "if": {"properties": {"type": {"const": "note"}}, "required": ["type"]},
          "then": {"not": {"required": ["end_time"]}}
        }
      ]
    },
    "collectionBinding": {
      "type": "object",
      "required": ["path"],
      "oneOf": [
        {
          "required": ["task"],
          "not": {"required": ["file"]}
        },
        {
          "required": ["file"],
          "not": {"required": ["task"]}
        }
      ],
      "properties": {
        "task": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "id_key": {"type": "string", "minLength": 1},
        "ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "patches": {"type": "object"},
        "append": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "attractionEvent": {
      "type": "object",
      "required": ["event_id", "start", "end", "weather_id", "title"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "start": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "end": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
        "weather_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "checkpoint_order": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "checkpoint_overrides": {"type": "object"},
        "entry": {"type": "object"},
        "exit": {"type": "object"},
        "overrides": {"type": "object"}
      }
    },
    "dailyRoute": {
      "type": "object",
      "required": ["id", "date", "title", "stops"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "title": {"type": "string", "minLength": 1},
        "mode": {"enum": ["car", "bus", "walk"]},
        "assumption": {"type": "string"},
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 18,
          "items": {
            "type": "object",
            "required": ["name", "coordinates", "coordinate_system"],
            "properties": {
              "event_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "coordinates": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?,-?[0-9]+(?:\\.[0-9]+)?$"},
              "coordinate_system": {"const": "GCJ-02"},
              "poi_id": {"type": "string", "minLength": 1},
              "note": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
